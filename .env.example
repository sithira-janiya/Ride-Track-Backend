# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Public URL of this API: used to build payment page links the app opens.
# On a phone, "localhost" is the phone itself, so use your computer's LAN IP (e.g. http://192.168.1.20:3000).
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=*

# Database: DB_CLIENT=mysql (default) or mssql (SQL Server / Azure SQL).
# MySQL (docker compose up -d db exposes it on port 3307)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3307
DB_USER=ridetrack
DB_PASSWORD=ridetrack_dev
DB_NAME=ridetrack
DB_SSL=false
# SQL Server only: a named instance (DB_PORT is then ignored), Windows sign-in (Windows only, needs the optional
# msnodesqlv8 package) and accepting a self-signed certificate. See "Using Microsoft SQL Server" in the README.
# DB_INSTANCE=SQLEXPRESS
# DB_TRUSTED_CONNECTION=true
# DB_TRUST_SERVER_CERTIFICATE=true

# Secrets. Use long random values in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Admin sessions are short: an admin signs in again after this many hours.
ADMIN_REFRESH_TTL_HOURS=12
QR_SIGNING_SECRET=change_me

# Payments: "mock" serves a fake checkout page. Production needs a real gateway.
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_KEY=change_me
# Only for demo deployments that deliberately use the mock gateway:
# ALLOW_MOCK_PAYMENTS=true

# GPS devices send this as the x-device-key header.
DEVICE_API_KEY=change_me

# Push notifications (optional): path to a Firebase service-account JSON, and `npm i firebase-admin`.
FCM_SERVICE_ACCOUNT=

# Google Cloud Translation API key (optional). When set, alerts are translated into each passenger's language.
GOOGLE_TRANSLATE_API_KEY=

ENABLE_JOBS=true
